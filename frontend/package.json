{
  "name": "portlog-ui",
  "version": "0.1.0",
  "private": true,
  "main": "desktop/electron-main.cjs",
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "test:e2e": "playwright test",
    "test": "node --test --test-concurrency=1 --experimental-strip-types",
    "typecheck": "tsc --noEmit",
    "start": "next start",
    "format": "oxfmt --check",
    "format:fix": "oxfmt",
    "postinstall": "node ../scripts/patch-pi-oauth-page.mjs",
    "lint": "oxlint && oxfmt --check",
    "lint:fix": "oxlint --fix && oxfmt",
    "desktop:dev": "electron desktop/electron-main.cjs",
    "portlog:review": "node --experimental-strip-types desktop/portlog-review.ts",
    "portlog:tui": "node --experimental-strip-types desktop/portlog-tui.ts",
    "prototype:pi-read": "node --experimental-strip-types desktop/pi-read-evidence-prototype.ts",
    "prototype:web-search": "node --experimental-strip-types desktop/web-search-prototype.ts",
    "prototype:web-search-agent": "node --experimental-strip-types desktop/web-search-agent-prototype.ts",
    "prototype:verifier-agent": "node --experimental-strip-types desktop/verifier-agent-prototype.ts",
    "prototype:gondolin": "node --experimental-strip-types desktop/gondolin-spike.ts",
    "test:desktop-native": "node desktop/electron-native-acceptance.mjs",
    "desktop:package": "node ../scripts/package-macos-release.mjs",
    "desktop:package:dir": "node ../scripts/package-macos-release.mjs",
    "desktop:verify": "PORTLOG_RELEASE_STAGE=release/stage PORTLOG_ELECTRON_APP=release/electron-app node --test --experimental-strip-types desktop/electron-release.test.ts && node ../scripts/verify-macos-release.mjs && PORTLOG_RELEASE_APP=release/dist/mac-arm64/PortLog.app PORTLOG_RELEASE_RESULTS=release/journey-results.json node desktop/electron-native-acceptance.mjs"
  },
  "dependencies": {
    "@ai-sdk/openai": "^3.0.73",
    "@assistant-ui/react": "latest",
    "@assistant-ui/react-ai-sdk": "latest",
    "@assistant-ui/react-markdown": "latest",
    "@earendil-works/gondolin": "0.10.0",
    "@earendil-works/pi-agent-core": "0.80.6",
    "@earendil-works/pi-ai": "0.80.6",
    "@radix-ui/react-avatar": "^1.2.0",
    "@radix-ui/react-collapsible": "^1.1.14",
    "@radix-ui/react-dialog": "^1.1.17",
    "@radix-ui/react-slot": "^1.3.0",
    "@radix-ui/react-tooltip": "^1.2.10",
    "@types/cytoscape": "^3.21.9",
    "@types/nodemailer": "^8.0.1",
    "ai": "^6.0.208",
    "better-auth": "^1.6.25",
    "better-sqlite3": "^12.11.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cytoscape": "^3.34.0",
    "cytoscape-dagre": "^4.0.0",
    "elkjs": "^0.11.1",
    "lucide-react": "^1.21.0",
    "next": "^16.2.9",
    "nodemailer": "^9.0.3",
    "radix-ui": "^1.6.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^4.12.1",
    "react-zoom-pan-pinch": "^4.0.3",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "tw-shimmer": "^0.4.11",
    "typebox": "^1.3.8",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@assistant-ui/next": "latest",
    "@playwright/test": "^1.51.1",
    "@tailwindcss/postcss": "^4.3.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^26.0.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "oxfmt": "^0.55.0",
    "oxlint": "^1.70.0",
    "tailwindcss": "^4.3.1",
    "typescript": "^6.0.3"
  }
}
