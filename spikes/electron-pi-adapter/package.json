{
  "name": "portlog-electron-pi-adapter-spike",
  "version": "0.0.0",
  "description": "PortLog Electron and Pi integration spike",
  "author": "PortLog",
  "private": true,
  "type": "module",
  "main": "src/electron-main.cjs",
  "scripts": {
    "test": "node --test --experimental-strip-types",
    "typecheck": "tsc --noEmit",
    "package:dir": "electron-builder --mac --dir --publish never",
    "prototype:pi": "node --experimental-strip-types prototype-pi-session.ts",
    "prototype:pi-auth": "node --experimental-strip-types prototype-pi-auth-status.ts"
  },
  "build": {
    "appId": "org.portlog.desktop.spike",
    "productName": "PortLog Spike",
    "files": [
      "src/electron-main.cjs",
      "src/electron-resource-path.cjs"
    ],
    "extraResources": [
      {
        "from": "review-sidecar",
        "to": "review-sidecar"
      }
    ],
    "mac": {
      "target": [
        "dir"
      ]
    }
  },
  "devDependencies": {
    "@earendil-works/pi-agent-core": "0.80.6",
    "@earendil-works/pi-ai": "0.80.6",
    "@earendil-works/pi-coding-agent": "0.80.6",
    "@types/node": "^26.0.0",
    "electron": "^40.0.0",
    "electron-builder": "^26.0.0",
    "typebox": "1.1.38",
    "typescript": "^6.0.3"
  }
}
