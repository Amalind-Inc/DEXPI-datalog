# Keep the build context small and free of host state. node_modules and .venv
# especially: both are large, and both are built for the host's platform, so
# copying them into an amd64 image would ship broken native extensions.

.git
.github
.venv
venv
**/__pycache__
**/*.pyc
.ruff_cache
.pytest_cache
.mypy_cache

frontend/node_modules
frontend/.next
frontend/playwright-report
frontend/test-results

.beads
.br_history
.artifacts
.tmp
test-results
embeddeddolt
backup
data

*.sqlite3
*.db
tsconfig.tsbuildinfo
.DS_Store
