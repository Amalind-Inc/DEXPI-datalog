.decl node_label(id:symbol, label:symbol)
.decl node_tag(id:symbol, tag:symbol)
.decl node_proteus_id(id:symbol, proteus_id:symbol)
.decl topology_attr_name(attr_name:symbol)
.decl composition_edge(source:symbol, target:symbol, attr_name:symbol)
.decl reference_edge(source:symbol, target:symbol, attr_name:symbol)
.decl candidate_topology_edge(source:symbol, target:symbol, attr_name:symbol)
.decl downstream_candidate(source:symbol, target:symbol)
.decl downstream_composition(source:symbol, target:symbol)
.decl downstream_reference(source:symbol, target:symbol)
.decl direct_process_connection(source:symbol, target:symbol)
.decl reachable(source:symbol, target:symbol)
.decl reachable_any(source:symbol, target:symbol)
.decl process_piping_attr_name(attr_name:symbol)
.decl process_piping_edge(source:symbol, target:symbol)
.decl piping_reachable(source:symbol, target:symbol)
.decl piping_connected(source:symbol, target:symbol)
.decl reachable_any_undirected(source:symbol, target:symbol)
.decl node_numeric_attribute(id:symbol, attr_name:symbol, value:number)

topology_attr_name("connections").
topology_attr_name("connectorReference").
topology_attr_name("nodes").
topology_attr_name("pipingNetworkSystems").
topology_attr_name("segments").
topology_attr_name("source").
topology_attr_name("sourceItem").
topology_attr_name("sourceNode").
topology_attr_name("target").
topology_attr_name("targetItem").
topology_attr_name("targetNode").

node_label(id, label) :- node_attribute(id, "label", label).
node_tag(id, tag) :- node_attribute(id, "tagName", tag).
node_proteus_id(id, proteus_id) :- node_attribute(id, "proteusId", proteus_id).

// Typed numeric view of source-provided attribute values. Only whole-number
// representations cast; non-numeric or fractional strings simply produce no
// fact (they remain available as symbols via node_attribute), so a rule that
// needs a number can distinguish "value present" from "no numeric value in
// the source" instead of inventing one.
node_numeric_attribute(id, attr_name, to_number(attr_value)) :-
    node_attribute(id, attr_name, attr_value),
    match("-?[0-9]+", attr_value).

composition_edge(source, target, attr_name) :-
    graph_edge_attribute(source, target, edge_key, "label", "composition"),
    graph_edge_attribute(source, target, edge_key, "attr_name", attr_name).

reference_edge(source, target, attr_name) :-
    graph_edge_attribute(source, target, edge_key, "label", "reference"),
    graph_edge_attribute(source, target, edge_key, "attr_name", attr_name).

candidate_topology_edge(source, target, attr_name) :-
    graph_edge_attribute(source, target, edge_key, "attr_name", attr_name),
    topology_attr_name(attr_name).

downstream_candidate(source, target) :- candidate_topology_edge(source, target, _).
downstream_composition(source, target) :- composition_edge(source, target, _).
downstream_reference(source, target) :- reference_edge(source, target, _).
direct_process_connection(source, target) :- reference_edge(source, target, "sourceItem").
direct_process_connection(source, target) :- reference_edge(source, target, "targetItem").
reachable(source, target) :- candidate_topology_edge(source, target, _).
reachable(source, target) :- candidate_topology_edge(source, intermediate, _), reachable(intermediate, target).

// Any-edge reachability: transitive closure over every directed edge,
// regardless of attr_name. This is the connectivity notion for questions
// phrased as "reachable by following the drawing's directed edges through
// any intermediate objects" (e.g. instrumentation-and-control monitoring
// paths), as opposed to `reachable`, which is restricted to the piping
// topology allowlist. Additive: `reachable` and its inputs are unchanged.
reachable_any(source, target) :- graph_edge(source, target, _).
reachable_any(source, target) :-
    graph_edge(source, intermediate, _), reachable_any(intermediate, target).

// Process-piping connectivity: the "piping path" edge set as defined by the
// connectivity questions (attr_name one of the names below). This is a
// distinct, additive notion from `topology_attr_name`/`reachable`, which are
// left byte-unchanged; notably it includes `nozzles` and `items` (equipment
// connects to the piping network through its nozzle sub-components).
process_piping_attr_name("sourceItem").
process_piping_attr_name("targetItem").
process_piping_attr_name("sourceNode").
process_piping_attr_name("targetNode").
process_piping_attr_name("nodes").
process_piping_attr_name("segments").
process_piping_attr_name("connections").
process_piping_attr_name("items").
process_piping_attr_name("pipingNetworkSystems").
process_piping_attr_name("nozzles").

process_piping_edge(source, target) :-
    graph_edge_attribute(source, target, edge_key, "attr_name", attr_name),
    process_piping_attr_name(attr_name).

// Directed piping reachability.
piping_reachable(source, target) :- process_piping_edge(source, target).
piping_reachable(source, target) :-
    process_piping_edge(source, intermediate), piping_reachable(intermediate, target).

// Undirected piping connectivity - a piping path "in either direction".
piping_connected(source, target) :- process_piping_edge(source, target).
piping_connected(source, target) :- process_piping_edge(target, source).
piping_connected(source, target) :-
    piping_connected(source, intermediate), piping_connected(intermediate, target).

// Undirected any-edge reachability (orthogonal direction axis for scope=any).
reachable_any_undirected(source, target) :- graph_edge(source, target, _).
reachable_any_undirected(source, target) :- graph_edge(target, source, _).
reachable_any_undirected(source, target) :-
    reachable_any_undirected(source, intermediate),
    reachable_any_undirected(intermediate, target).
